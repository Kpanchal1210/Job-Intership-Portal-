@model Job_InternshipPortal.Models.ViewModels.JobSeekerDashboardViewModel
@using Job_InternshipPortal.Models
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container py-4">

    @if (Model.Selected > 0)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center gap-3">
            <div class="fs-1 text-success">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1">🎉 Congratulations, @Model.FullName!</h4>
                <p class="mb-0 text-success-emphasis">
                    You have been <strong>Selected</strong> for <strong>@Model.Selected @(Model.Selected == 1 ? "position" : "positions")</strong>! The employer will contact you regarding next steps and formal onboarding.
                </p>
            </div>
        </div>
    }

    @* ── Welcome Banner ─────────────────────────────────────────────────────── *@
    <div class="card border-0 bg-primary text-white rounded-3 shadow-sm mb-4 p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <h2 class="fw-bold mb-1">Welcome back, @Model.FullName!</h2>
                <p class="mb-0 opacity-75">Track your applications, interviews, and saved jobs — all in one place.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-light text-primary fw-semibold">Browse Jobs</a>
                <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-light">My Applications</a>
            </div>
        </div>
    </div>

    @* ── Stats Cards (Clean & Proportional) ─────────────────────────────────── *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-lg">
            <a asp-controller="JobApplications" asp-action="Index" class="text-decoration-none">
                <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                    <div class="h3 fw-bold text-primary mb-1">@Model.TotalApplications</div>
                    <div class="text-muted small fw-semibold">Total Applications</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                <div class="h3 fw-bold text-secondary mb-1">@Model.AppliedCount</div>
                <div class="text-muted small fw-semibold">Applied</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                <div class="h3 fw-bold text-info mb-1">@Model.ApplicationsUnderReview</div>
                <div class="text-muted small fw-semibold">Under Review</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                <div class="h3 fw-bold text-warning mb-1">@Model.Shortlisted</div>
                <div class="text-muted small fw-semibold">Shortlisted</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                <div class="h3 fw-bold text-success mb-1">@Model.Selected</div>
                <div class="text-muted small fw-semibold">Selected</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                <div class="h3 fw-bold text-secondary mb-1">@Model.RejectedApplications</div>
                <div class="text-muted small fw-semibold">Rejected</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <a asp-controller="Interviews" asp-action="Index" class="text-decoration-none">
                <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                    <div class="h3 fw-bold text-primary mb-1">@Model.UpcomingInterviewCount</div>
                    <div class="text-muted small fw-semibold">Interviews</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg">
            <a asp-controller="SavedJobs" asp-action="Index" class="text-decoration-none">
                <div class="card border bg-white shadow-sm h-100 rounded-3 p-3 text-center">
                    <div class="h3 fw-bold text-secondary mb-1">@Model.SavedJobsCount</div>
                    <div class="text-muted small fw-semibold">Saved Jobs</div>
                </div>
            </a>
        </div>
    </div>

    <div class="row g-4">

        @* ── Left column ───────────────────────────────────────────────────────── *@
        <div class="col-12 col-xl-8">

            @* Selected Applications / Job Offers *@
            @if (Model.SelectedApplicationsList != null && Model.SelectedApplicationsList.Any())
            {
                <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-success border-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-patch-check-fill text-success fs-5"></i>
                            <h5 class="mb-0 fw-bold text-dark">Selected Positions &amp; Job Offers</h5>
                        </div>
                        <span class="badge bg-success-subtle text-success-emphasis border px-2 py-1">@Model.SelectedApplicationsList.Count Selected</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var app in Model.SelectedApplicationsList)
                        {
                            <div class="list-group-item px-4 py-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <div class="fw-bold text-dark fs-6">
                                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" class="text-decoration-none text-dark">
                                                @(app.Job?.Title ?? "Position")
                                            </a>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-building"></i> @(app.Job?.Company?.CompanyName ?? "Company")
                                            @if (app.SelectedDate.HasValue)
                                            {
                                                <span class="ms-2 text-success fw-semibold">
                                                    <i class="bi bi-calendar-check"></i> Selected on @app.SelectedDate.Value.ToLocalTime().ToString("MMM d, yyyy")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="badge bg-success text-white px-3 py-2 fw-semibold">
                                            <i class="bi bi-check2-circle"></i> Selected Candidate
                                        </span>
                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary btn-sm">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Shortlisted Applications *@
            @if (Model.ShortlistedApplicationsList != null && Model.ShortlistedApplicationsList.Any())
            {
                <div class="card border-0 shadow-sm rounded-3 mb-4 border-start border-warning border-4">
                    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-star-fill text-warning fs-5"></i>
                            <h5 class="mb-0 fw-bold text-dark">Shortlisted Applications</h5>
                        </div>
                        <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1">@Model.ShortlistedApplicationsList.Count Shortlisted</span>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var app in Model.ShortlistedApplicationsList)
                        {
                            <div class="list-group-item px-4 py-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div>
                                        <div class="fw-bold text-dark">
                                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobId" class="text-decoration-none text-dark">
                                                @(app.Job?.Title ?? "Position")
                                            </a>
                                        </div>
                                        <div class="small text-muted">
                                            <i class="bi bi-building"></i> @(app.Job?.Company?.CompanyName ?? "Company")
                                            <span class="ms-2">Applied @app.AppliedDate.ToLocalTime().ToString("MMM d, yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <span class="badge bg-warning-subtle text-warning-emphasis border px-2 py-1">
                                            Shortlisted
                                        </span>
                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-primary btn-sm">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Recent Applications *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0 fw-bold">Recent Applications</h5>
                    <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
                </div>
                @if (Model.RecentApplications.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3 fw-semibold text-secondary">Job Title</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Company</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Applied</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Status</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.RecentApplications)
                                {
                                    <tr>
                                        <td class="px-4 py-3 fw-semibold">@(app.Job?.Title ?? "—")</td>
                                        <td class="px-3 py-3 text-muted">@(app.Job?.Company?.CompanyName ?? "—")</td>
                                        <td class="px-3 py-3 text-muted">@app.AppliedDate.ToLocalTime().ToString("MMM d, yyyy")</td>
                                        <td class="px-3 py-3">
                                            @{
                                                var (bg, fg) = app.Status switch
                                                {
                                                    ApplicationStatus.Selected    => ("bg-success-subtle", "text-success-emphasis"),
                                                    ApplicationStatus.Rejected    => ("bg-danger-subtle",  "text-danger-emphasis"),
                                                    ApplicationStatus.Shortlisted => ("bg-warning-subtle", "text-warning-emphasis"),
                                                    ApplicationStatus.Interview   => ("bg-info-subtle",    "text-info-emphasis"),
                                                    ApplicationStatus.UnderReview => ("bg-primary-subtle", "text-primary-emphasis"),
                                                    _                             => ("bg-secondary-subtle","text-secondary-emphasis")
                                                };
                                            }
                                            <span class="badge @bg @fg border px-2 py-1">@app.Status</span>
                                        </td>
                                        <td class="px-3 py-3 text-end">
                                            <a asp-controller="JobApplications" asp-action="Details"
                                               asp-route-id="@app.Id"
                                               class="btn btn-outline-secondary btn-sm">Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <p class="mb-2">You haven't applied to any jobs yet.</p>
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary btn-sm">Browse Jobs</a>
                    </div>
                }
            </div>

            @* Upcoming Interviews *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0 fw-bold">Upcoming Interviews</h5>
                    <a asp-controller="Interviews" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
                </div>
                @if (Model.UpcomingInterviews.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3 fw-semibold text-secondary">Job</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Company</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Date &amp; Time</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Type</th>
                                    <th class="px-3 py-3 fw-semibold text-secondary">Link / Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var iv in Model.UpcomingInterviews)
                                {
                                    <tr>
                                        <td class="px-4 py-3 fw-semibold">@(iv.JobApplication?.Job?.Title ?? "—")</td>
                                        <td class="px-3 py-3 text-muted">@(iv.JobApplication?.Job?.Company?.CompanyName ?? "—")</td>
                                        <td class="px-3 py-3">@iv.InterviewDate.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                        <td class="px-3 py-3">
                                            <span class="badge @(iv.InterviewType == InterviewType.Online ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis") border px-2 py-1">
                                                @iv.InterviewType
                                            </span>
                                        </td>
                                        <td class="px-3 py-3">
                                            @if (!string.IsNullOrWhiteSpace(iv.MeetingLink))
                                            {
                                                <a href="@iv.MeetingLink" target="_blank" rel="noopener" class="btn btn-outline-info btn-sm">Join</a>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(iv.Location))
                                            {
                                                <span class="text-muted small">@iv.Location</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <p class="mb-0">No upcoming interviews scheduled.</p>
                    </div>
                }
            </div>

            @* Recommended Jobs *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0 fw-bold">Recommended Jobs</h5>
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary btn-sm">Browse All</a>
                </div>
                @if (Model.RecommendedJobs.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var job in Model.RecommendedJobs)
                        {
                            <div class="list-group-item px-4 py-3">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                    <div>
                                        <div class="fw-semibold text-dark">
                                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id"
                                               class="text-decoration-none text-dark">@job.Title</a>
                                        </div>
                                        <div class="small text-muted">
                                            @(job.Company?.CompanyName ?? "")
                                            @if (!string.IsNullOrWhiteSpace(job.Location))
                                            { <span> &bull; @job.Location</span> }
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 flex-wrap align-items-center">
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border px-2">
                                            @(job.JobType == JobType.FullTime ? "Full Time" : job.JobType == JobType.PartTime ? "Part Time" : "Internship")
                                        </span>
                                        <span class="small text-muted">Deadline: @job.LastDate.ToString("MMM d")</span>
                                        <a asp-controller="JobApplications" asp-action="Create"
                                           asp-route-jobId="@job.Id"
                                           class="btn btn-primary btn-sm">Apply</a>
                                        <a asp-controller="SavedJobs" asp-action="Create"
                                           asp-route-jobId="@job.Id"
                                           class="btn btn-outline-secondary btn-sm">Save</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <p class="mb-0">No new job recommendations right now. Check back soon.</p>
                    </div>
                }
            </div>

        </div>

        @* ── Right column ──────────────────────────────────────────────────────── *@
        <div class="col-12 col-xl-4">

            @* Quick Actions *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-bold">Quick Actions</h5>
                </div>
                <div class="card-body d-grid gap-2 p-4">
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary">Browse Jobs</a>
                    <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-primary">View My Applications</a>
                    <a asp-controller="SavedJobs" asp-action="Index" class="btn btn-outline-secondary">View Saved Jobs</a>
                    <a asp-controller="Interviews" asp-action="Index" class="btn btn-outline-secondary">View Interviews</a>
                </div>
            </div>

            @* Saved Jobs *@
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                    <h5 class="mb-0 fw-bold">Saved Jobs</h5>
                    <a asp-controller="SavedJobs" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
                </div>
                @if (Model.RecentSavedJobs.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var saved in Model.RecentSavedJobs)
                        {
                            <div class="list-group-item px-4 py-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="me-2 overflow-hidden">
                                        <div class="fw-semibold text-truncate">
                                            <a asp-controller="Jobs" asp-action="Details"
                                               asp-route-id="@saved.JobId"
                                               class="text-decoration-none text-dark">@(saved.Job?.Title ?? "Job")</a>
                                        </div>
                                        <div class="small text-muted">@(saved.Job?.Company?.CompanyName ?? "")</div>
                                    </div>
                                    <form asp-controller="SavedJobs" asp-action="Delete"
                                          asp-route-id="@saved.Id" method="get"
                                          class="d-inline flex-shrink-0">
                                        <a asp-controller="SavedJobs" asp-action="Delete"
                                           asp-route-id="@saved.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           onclick="return confirm('Remove this saved job?')">✕</a>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <p class="mb-2 small">No saved jobs yet.</p>
                        <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary btn-sm">Browse Jobs</a>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .hover-card { transition: transform .15s ease, box-shadow .15s ease; cursor: pointer; }
    .hover-card:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important; }
</style>
