    <main role="main" class="flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                    <div>@TempData["Success"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>@TempData["Error"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-info alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>@TempData["Info"]</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- Modern Global Portal Footer -->
    <footer class="portal-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-12 col-md-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon" style="width:36px; height:36px; font-size:1rem;"><i class="bi bi-briefcase-fill text-white"></i></span>
                        <h4 class="fw-bold text-white mb-0">Job &amp; Internship Portal</h4>
                    </div>
                    <p class="text-secondary small mb-3" style="max-width: 420px; line-height: 1.6;">
                        A centralized platform empowering students and job seekers to land their dream roles, while enabling verified companies and recruiters to discover top talent with streamlined applications and interview scheduling.
                    </p>
                    <div class="d-flex gap-2 text-secondary small">
                        <span class="badge bg-dark border text-light"><i class="bi bi-shield-check text-success"></i> Verified Companies</span>
                        <span class="badge bg-dark border text-light"><i class="bi bi-clock-history text-info"></i> Real-Time Tracking</span>
                    </div>
                </div>
                <div class="col-6 col-md-2 col-lg-2">
                    <h5>For Candidates</h5>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Jobs" asp-action="Index"><i class="bi bi-chevron-right small"></i> Browse Jobs</a></li>
                        <li><a asp-controller="Jobs" asp-action="Index" asp-route-jobType="@JobType.Internship"><i class="bi bi-chevron-right small"></i> Internships</a></li>
                        <li><a asp-controller="Companies" asp-action="Index"><i class="bi bi-chevron-right small"></i> Top Companies</a></li>
