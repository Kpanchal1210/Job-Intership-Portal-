@model RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card shadow-sm border rounded-4 bg-white">
                <div class="card-body p-4 p-sm-5">
                    <div class="text-center mb-4">
                        <div class="brand-icon mx-auto mb-2" style="width:48px; height:48px; font-size:1.4rem;">
                            <i class="bi bi-person-plus text-white"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-1">Create Account</h2>
                        <p class="text-muted small">Join as a candidate to find jobs, or as a company to hire talent</p>
                    </div>

                    <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Role Selection with visual cards -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary d-block mb-2">Account Type</label>
                            <div class="role-selector-group">
                                <div>
                                    <input class="d-none role-radio-input" type="radio" asp-for="Role" value="@UserRoles.JobSeeker" id="roleJobSeeker" checked />
                                    <label class="role-radio-label" for="roleJobSeeker">
                                        <i class="bi bi-mortarboard"></i>
                                        <span>Job Seeker</span>
                                    </label>
                                </div>
                                <div>
                                    <input class="d-none role-radio-input" type="radio" asp-for="Role" value="@UserRoles.Recruiter" id="roleRecruiter" />
                                    <label class="role-radio-label" for="roleRecruiter">
                                        <i class="bi bi-building"></i>
                                        <span>Company</span>
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="Role" class="text-danger small d-block mt-1"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary">Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Morgan" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                            </div>
                            <div class="form-text text-muted small">
                                Min. 8 characters with uppercase, lowercase, number, and special symbol.
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-shield-lock text-muted"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm your password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-portal-primary py-2 fw-semibold shadow-sm">
                                Create Account
                            </button>
                        </div>

                        <!-- Footer Link -->
                        <div class="text-center pt-3 border-top">
                            <p class="text-muted small mb-0">
                                Already have an account?
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-primary text-decoration-none fw-semibold">
                                    Sign In
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
