@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border p-5">
                <i class="bi bi-shield-lock text-danger display-1 mb-3"></i>
                <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
                <p class="text-muted mb-4">You do not have permission to access this resource.</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
