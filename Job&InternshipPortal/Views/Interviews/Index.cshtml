@model IEnumerable<Job_InternshipPortal.Models.Interview>
@{
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(UserRoles.Admin);
    var isRecruiter = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    ViewData["Title"] = isAdmin ? "All Interviews" : isRecruiter ? "Company Interviews" : "My Interviews";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark mb-0">@(isAdmin ? "All Interviews" : isRecruiter ? "Company Interviews" : "My Interviews")</h2>
        @if (isRecruiter)
        {
            <a asp-controller="Interviews" asp-action="Create" class="btn btn-primary">
                + Schedule Interview
            </a>
        }
    </div>

    @if (isRecruiter || isAdmin)
    {
        <!-- Recruiter Interview List -->
        @if (Model != null && Model.Any())
        {
            <div class="card bg-white border rounded-3 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Candidate</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Job</th>
                                @if (isAdmin)
                                {
                                    <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Company</th>
                                }
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Date</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Status</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-semibold text-dark">
                                        @(item.JobApplication?.Applicant?.FullName ?? item.JobApplication?.Applicant?.UserName ?? "Candidate")
                                    </td>
                                    <td class="py-3 px-4 text-muted">
                                        @(item.JobApplication?.Job?.Title ?? "Job")
                                    </td>
                                    @if (isAdmin)
                                    {
                                        <td class="py-3 px-4 text-muted">
                                            @(item.JobApplication?.Job?.Company?.CompanyName ?? "Company")
                                        </td>
                                    }
                                    <td class="py-3 px-4 text-muted">
                                        @item.InterviewDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td class="py-3 px-4">
                                        @{
                                            var isCandidateSelected = item.JobApplication?.Status == ApplicationStatus.Selected;
                                            var isCandidateRejected = item.JobApplication?.Status == ApplicationStatus.Rejected;
                                            var status = item.Status;

                                            var (badgeClass, statusText) = isCandidateSelected
                                                ? ("bg-success-subtle text-success-emphasis", "Completed (Selected)")
                                                : isCandidateRejected
                                                    ? ("bg-danger-subtle text-danger-emphasis", "Closed (Rejected)")
                                                    : status == InterviewStatus.Completed
                                                        ? ("bg-success-subtle text-success-emphasis", "Completed")
                                                        : status == InterviewStatus.Cancelled
                                                            ? ("bg-danger-subtle text-danger-emphasis", "Cancelled")
                                                            : ("bg-info-subtle text-info-emphasis", "Scheduled");
                                        }
                                        <span class="badge @badgeClass border px-2 py-1">
                                            @if (isCandidateSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="Interviews" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                                View Details
                                            </a>
                                            @if (!isCandidateSelected && !isCandidateRejected && item.Status == InterviewStatus.Scheduled)
                                            {
                                                <a asp-controller="Interviews" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                                    Edit
                                                </a>
                                                <a asp-controller="Interviews" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white border rounded-3 shadow-sm p-4">
                <p class="lead text-muted mb-4">No interviews scheduled yet.</p>
                <a asp-controller="Interviews" asp-action="Create" class="btn btn-primary px-4">
                    + Schedule Interview
                </a>
            </div>
        }
    }
    else
    {
        <!-- Job Seeker: My Interviews Table -->
        @if (Model != null && Model.Any())
        {
            <div class="card bg-white border rounded-3 shadow-sm overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Job</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Company</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Date</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Mode</th>
                                <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="py-3 px-4 fw-semibold text-dark">
                                        @(item.JobApplication?.Job?.Title ?? "Job")
                                    </td>
                                    <td class="py-3 px-4 text-muted">
                                        @(item.JobApplication?.Job?.Company?.CompanyName ?? "Company")
                                    </td>
                                    <td class="py-3 px-4 text-muted">
                                        @item.InterviewDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td class="py-3 px-4">
                                        @{
                                            var isCandidateSelected = item.JobApplication?.Status == ApplicationStatus.Selected;
                                            var isCandidateRejected = item.JobApplication?.Status == ApplicationStatus.Rejected;
                                            var status = item.Status;

                                            var (badgeClass, statusText) = isCandidateSelected
                                                ? ("bg-success-subtle text-success-emphasis", "Completed (Selected)")
                                                : isCandidateRejected
                                                    ? ("bg-danger-subtle text-danger-emphasis", "Closed")
                                                    : status == InterviewStatus.Completed
                                                        ? ("bg-success-subtle text-success-emphasis", "Completed")
                                                        : status == InterviewStatus.Cancelled
                                                            ? ("bg-danger-subtle text-danger-emphasis", "Cancelled")
                                                            : ("bg-info-subtle text-info-emphasis", "Scheduled");
                                        }
                                        <span class="badge @badgeClass border px-2 py-1">
                                            @if (isCandidateSelected)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            @statusText
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-end">
                                        <a asp-controller="Interviews" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white border rounded-3 shadow-sm p-4">
                <p class="lead text-muted mb-0">No interviews scheduled yet.</p>
            </div>
        }
    }
</div>
