@model Job_InternshipPortal.Models.Interview
@{
    ViewData["Title"] = "Delete Interview";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card bg-white border rounded-3 shadow-sm p-4 text-center">
                <div class="card-body">
                    <h3 class="fw-bold text-danger mb-3">Delete Interview</h3>
                    <p class="text-muted mb-4">Are you sure you want to delete this interview?</p>

                    <div class="p-3 bg-light rounded-3 border mb-4 text-start">
                        <p class="mb-1">
                            <strong>Candidate:</strong>
                            <span class="text-dark">@(Model.JobApplication?.Applicant?.FullName ?? Model.JobApplication?.Applicant?.UserName ?? "Candidate")</span>
                        </p>
                        <p class="mb-0">
                            <strong>Job:</strong>
                            <span class="text-dark">@(Model.JobApplication?.Job?.Title ?? "Job")</span>
                        </p>
                    </div>

                    <form asp-controller="Interviews" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Delete
                            </button>
                            <a asp-controller="Interviews" asp-action="Index" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
