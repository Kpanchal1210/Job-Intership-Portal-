@model Job_InternshipPortal.Models.Job
@{
    var isRecruiter = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    var isJobSeeker = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("JobSeeker") || User.IsInRole(UserRoles.JobSeeker));
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(UserRoles.Admin);
    var isJobOwner = (ViewBag.IsJobOwner as bool?) ?? (isAdmin || (isRecruiter && Model.Company != null));

    ViewData["Title"] = Model.Title + " - Job Details";

    var typeBadgeClass = Model.JobType switch
    {
        JobType.Internship => "badge-internship",
        JobType.PartTime   => "badge-parttime",
        _                  => "badge-fulltime"
    };

    var companyInitial = !string.IsNullOrWhiteSpace(Model.Company?.CompanyName)
        ? Model.Company.CompanyName.Substring(0, 1).ToUpper()
        : "C";

    var applicantsList = Model.JobApplications?.OrderByDescending(a => a.AppliedDate).ToList() ?? new List<JobApplication>();
    var totalApplicantsCount = applicantsList.Count;
    var placedCandidates = ViewBag.PlacedCandidates as Dictionary<string, string>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <!-- Breadcrumbs -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index" class="text-decoration-none">Jobs</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            <div class="card bg-white border rounded-3 shadow-sm p-4 p-md-4 mb-4">
                <!-- Job Header -->
                <div class="d-flex flex-column flex-sm-row align-items-start justify-content-between gap-3 mb-4 pb-3 border-bottom">
                    <div class="d-flex align-items-start gap-3">
                        <div class="job-company-avatar rounded-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                            @companyInitial
                        </div>
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h2 class="h4 fw-bold text-dark mb-0">@Model.Title</h2>
                                <span class="badge-job-type @typeBadgeClass">
                                    @(Model.JobType == JobType.FullTime ? "Full Time" : Model.JobType == JobType.PartTime ? "Part Time" : "Internship")
                                </span>
                                @if (Model.Status != JobStatus.Approved)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border">
                                        @Model.Status
                                    </span>
                                }
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small">
                                <span class="fw-semibold text-primary">
                                    <i class="bi bi-building"></i> @(Model.Company?.CompanyName ?? "Company")
                                </span>
                                <span>
                                    <i class="bi bi-geo-alt"></i> @(Model.Location ?? "Not Specified")
                                </span>
                                <span>
                                    <i class="bi bi-calendar3"></i> Posted @Model.CreatedDate.ToString("MMM d, yyyy")
                                </span>
                            </div>
                        </div>
                    </div>
                    @if (isJobOwner || isAdmin)
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-controller="Jobs" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    }
                </div>

                <!-- Job Quick Facts Grid (Uniform, Simple, Clean) -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border text-center h-100">
                            <div class="text-muted small fw-semibold">Offered Salary</div>
                            <div class="fw-bold text-success fs-5 mt-1">
                                @(Model.Salary.HasValue ? $"₹{Model.Salary.Value:N0}" : "Negotiable")
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border text-center h-100">
                            <div class="text-muted small fw-semibold">Employment Type</div>
                            <div class="fw-bold text-dark fs-5 mt-1">
                                @Model.JobType
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border text-center h-100">
                            <div class="text-muted small fw-semibold">Application Deadline</div>
                            <div class="fw-bold text-dark fs-5 mt-1">
                                @Model.LastDate.ToString("MMM d, yyyy")
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-light rounded-3 border text-center h-100">
                            <div class="text-muted small fw-semibold">Applicants</div>
                            <div class="fw-bold text-primary fs-5 mt-1">
                                @totalApplicantsCount
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-file-text text-primary"></i> Job Description</h5>
                    <div class="text-secondary" style="white-space: pre-line; line-height: 1.6;">
                        @Model.Description
                    </div>
                </div>

                <!-- Requirements -->
                <div class="mb-4">
                    <h5 class="fw-bold text-dark mb-2"><i class="bi bi-check2-circle text-primary"></i> Skills &amp; Requirements</h5>
                    <div class="text-secondary" style="white-space: pre-line; line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.Requirements) ? "No specific requirements provided." : Model.Requirements)
                    </div>
                </div>

                <!-- About the Company -->
                @if (Model.Company != null)
                {
                    <div class="card border rounded-3 p-3 bg-light mb-4">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">About @Model.Company.CompanyName</h6>
                                <p class="text-muted small mb-0">@(string.IsNullOrWhiteSpace(Model.Company.Description) ? "Verified recruiting partner on Job & Internship Portal." : Model.Company.Description)</p>
                            </div>
                            <a asp-controller="Companies" asp-action="Details" asp-route-id="@Model.Company.Id" class="btn btn-outline-primary btn-sm">
                                Company Profile
                            </a>
                        </div>
                    </div>
                }

                <!-- Simple, Clean Applicants Section for Recruiter/Admin -->
                @if (isJobOwner || isAdmin)
                {
                    <div class="card border rounded-3 bg-white p-3 p-md-4 mb-4" id="applicants">
                        <div class="d-flex justify-content-between align-items-center pb-2 border-bottom mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="bi bi-people text-primary"></i> Applicants (@totalApplicantsCount)
                                </h5>
                                <div class="text-muted small">Candidates who applied for this position</div>
                            </div>
                            @if (totalApplicantsCount > 0)
                            {
                                <a asp-controller="JobApplications" asp-action="Index" asp-route-jobId="@Model.Id" class="btn btn-outline-secondary btn-sm">
                                    View in Applications Table
                                </a>
                            }
                        </div>

                        @if (totalApplicantsCount == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-person-x fs-1 text-secondary d-block mb-2"></i>
                                <div class="fw-semibold text-dark">No applicants yet</div>
                                <div class="small text-muted">When candidates submit applications, they will appear here with resumes and review actions.</div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light border-bottom">
                                        <tr>
                                            <th scope="col" class="py-2 px-3 fw-semibold text-secondary small">Candidate</th>
                                            <th scope="col" class="py-2 px-3 fw-semibold text-secondary small">Applied Date</th>
                                            <th scope="col" class="py-2 px-3 fw-semibold text-secondary small">Status</th>
                                            <th scope="col" class="py-2 px-3 fw-semibold text-secondary small">Resume</th>
                                            <th scope="col" class="py-2 px-3 fw-semibold text-secondary text-end small">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var app in applicantsList)
                                        {
                                            var candidateName = app.Applicant?.FullName ?? app.Applicant?.UserName ?? "Applicant";
                                            var candidateEmail = app.Applicant?.Email ?? "—";
                                            string? placedTitle = null;
                                            var isPlacedElsewhere = placedCandidates != null && placedCandidates.TryGetValue(app.ApplicantId, out placedTitle);

                                            var (badgeClass, badgeText) = app.Status switch
                                            {
                                                ApplicationStatus.Selected    => ("bg-success", "Selected"),
                                                ApplicationStatus.Rejected    => ("bg-danger", "Rejected"),
                                                ApplicationStatus.Shortlisted => ("bg-warning text-dark", "Shortlisted"),
                                                ApplicationStatus.Interview   => ("bg-info text-dark", "Interview"),
                                                ApplicationStatus.UnderReview => ("bg-primary-subtle text-primary border", "Under Review"),
                                                _                             => ("bg-secondary-subtle text-secondary border", "Applied")
                                            };

                                            <tr>
                                                <td class="py-2 px-3">
                                                    <div class="fw-semibold text-dark">@candidateName</div>
                                                    <div class="text-muted small">@candidateEmail</div>
                                                    @if (isPlacedElsewhere)
                                                    {
                                                        <div class="mt-1">
                                                            <span class="badge bg-secondary text-white" style="font-size: 0.72rem;" title="Already selected for @placedTitle">
                                                                <i class="bi bi-lock-fill"></i> Placed Elsewhere
                                                            </span>
                                                        </div>
                                                    }
                                                </td>
                                                <td class="py-2 px-3 text-muted small">
                                                    @app.AppliedDate.ToString("MMM d, yyyy")
                                                </td>
                                                <td class="py-2 px-3">
                                                    @if (isPlacedElsewhere && app.Status != ApplicationStatus.Selected)
                                                    {
                                                        <span class="badge bg-secondary text-white px-2 py-1">
                                                            <i class="bi bi-lock-fill"></i> Placed Elsewhere
                                                        </span>
                                                        <div class="text-muted small mt-1" style="font-size: 0.72rem;">
                                                            Selected for @placedTitle
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge @badgeClass px-2 py-1">
                                                            @badgeText
                                                        </span>
                                                        @if (app.Status == ApplicationStatus.Selected && app.SelectedDate.HasValue)
                                                        {
                                                            <div class="text-muted small mt-1" style="font-size: 0.72rem;">
                                                                Selected on @app.SelectedDate.Value.ToString("MMM d")
                                                            </div>
                                                        }
                                                    }
                                                </td>
                                                <td class="py-2 px-3">
                                                    @if (!string.IsNullOrEmpty(app.ResumePath))
                                                    {
                                                        <a href="@app.ResumePath" target="_blank" class="btn btn-outline-primary btn-sm py-1 px-2" title="View Resume PDF">
                                                            <i class="bi bi-file-earmark-pdf"></i> Resume
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">—</span>
                                                    }
                                                </td>
                                                <td class="py-2 px-3 text-end">
                                                    <div class="d-inline-flex gap-1 justify-content-end align-items-center">
                                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@app.Id" class="btn btn-outline-secondary btn-sm py-1 px-2">
                                                            View
                                                        </a>

                                                        @if (isPlacedElsewhere && app.Status != ApplicationStatus.Selected)
                                                        {
                                                            <span class="badge bg-light text-secondary border py-1 px-2" style="font-size: 0.75rem;" title="Candidate has already been placed in @placedTitle.">
                                                                <i class="bi bi-lock-fill"></i> Locked
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            @if (app.Status == ApplicationStatus.Applied)
                                                            {
                                                                <form asp-controller="Companies" asp-action="MarkUnderReview" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@app.Id" />
                                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path#applicants" />
                                                                    <button type="submit" class="btn btn-outline-primary btn-sm py-1 px-2" title="Mark as Under Review">
                                                                        Review
                                                                    </button>
                                                                </form>
                                                                <form asp-controller="Companies" asp-action="ShortlistCandidate" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@app.Id" />
                                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path#applicants" />
                                                                    <button type="submit" class="btn btn-outline-warning text-dark btn-sm py-1 px-2" title="Shortlist Candidate">
                                                                        Shortlist
                                                                    </button>
                                                                </form>
                                                            }

                                                            @if (app.Status == ApplicationStatus.UnderReview)
                                                            {
                                                                <form asp-controller="Companies" asp-action="ShortlistCandidate" method="post" class="d-inline">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@app.Id" />
                                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path#applicants" />
                                                                    <button type="submit" class="btn btn-outline-warning text-dark btn-sm py-1 px-2" title="Shortlist Candidate">
                                                                        Shortlist
                                                                    </button>
                                                                </form>
                                                                <a asp-controller="Interviews" asp-action="Create" asp-route-applicationId="@app.Id" class="btn btn-outline-info text-dark btn-sm py-1 px-2" title="Schedule Interview">
                                                                    Interview
                                                                </a>
                                                            }

                                                            @if (app.Status == ApplicationStatus.Shortlisted)
                                                            {
                                                                @if (app.Interviews == null || !app.Interviews.Any())
                                                                {
                                                                    <a asp-controller="Interviews" asp-action="Create" asp-route-applicationId="@app.Id" class="btn btn-outline-info text-dark btn-sm py-1 px-2" title="Schedule Interview">
                                                                        Interview
                                                                    </a>
                                                                }
                                                                <button type="button" class="btn btn-success btn-sm py-1 px-2" data-bs-toggle="modal" data-bs-target="#selectModal-@app.Id" title="Select Directly">
                                                                    Select
                                                                </button>
                                                            }
                                                            else if (app.Status == ApplicationStatus.Interview)
                                                            {
                                                                @if (app.Interviews != null && app.Interviews.Any())
                                                                {
                                                                    <a asp-controller="Interviews" asp-action="Details" asp-route-id="@app.Interviews.First().Id" class="btn btn-outline-info text-dark btn-sm py-1 px-2" title="View Scheduled Interview">
                                                                        View Interview
                                                                    </a>
                                                                }
                                                                <button type="button" class="btn btn-success btn-sm py-1 px-2" data-bs-toggle="modal" data-bs-target="#selectModal-@app.Id" title="Select Candidate">
                                                                    Select
                                                                </button>
                                                            }

                                                            @if (app.Status != ApplicationStatus.Selected && app.Status != ApplicationStatus.Rejected)
                                                            {
                                                                <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2" data-bs-toggle="modal" data-bs-target="#rejectModal-@app.Id">
                                                                    Reject
                                                                </button>
                                                            }
                                                        }
                                                    </div>

                                                    <!-- Select Confirmation Modal -->
                                                    @if (app.Status == ApplicationStatus.Shortlisted || app.Status == ApplicationStatus.Interview)
                                                    {
                                                        <div class="modal fade" id="selectModal-@app.Id" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Select Candidate</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        Are you sure you want to select <strong>@candidateName</strong> for <strong>@Model.Title</strong>?
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                        <form asp-controller="Companies" asp-action="SelectCandidate" method="post" class="d-inline">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="id" value="@app.Id" />
                                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path#applicants" />
                                                                            <button type="submit" class="btn btn-success btn-sm px-3">Confirm Selection</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    <!-- Reject Confirmation Modal -->
                                                    @if (app.Status != ApplicationStatus.Selected && app.Status != ApplicationStatus.Rejected)
                                                    {
                                                        <div class="modal fade" id="rejectModal-@app.Id" tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog modal-dialog-centered text-start">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title fw-bold">Reject Candidate</h5>
                                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        Are you sure you want to mark <strong>@candidateName</strong> as rejected for <strong>@Model.Title</strong>?
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                                        <form asp-controller="Companies" asp-action="RejectCandidate" method="post" class="d-inline">
                                                                            @Html.AntiForgeryToken()
                                                                            <input type="hidden" name="id" value="@app.Id" />
                                                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path#applicants" />
                                                                            <button type="submit" class="btn btn-danger btn-sm px-3">Confirm Rejection</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

                <!-- Action Footer -->
                <div class="pt-3 border-top d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <div>
                        <a asp-controller="@(isAdmin ? "Admin" : "Jobs")" asp-action="@(isAdmin ? "Jobs" : "Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> @(isAdmin ? "Back to Admin Jobs" : "Back to Jobs")
                        </a>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        @if (isJobOwner || isAdmin)
                        {
                            <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-pencil"></i> Edit Job
                            </a>
                            <a asp-controller="Jobs" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                <i class="bi bi-trash"></i> Delete Job
                            </a>
                        }
                        @if (isJobSeeker)
                        {
                            var hasApplied = ViewData["HasApplied"] as bool? ?? false;
                            var hasSaved = ViewData["HasSaved"] as bool? ?? false;
                            if (hasSaved)
                            {
                                <button class="btn btn-outline-secondary px-3" disabled="disabled" title="You have already saved this job">
                                    <i class="bi bi-bookmark-check-fill text-success"></i> Saved
                                </button>
                            }
                            else
                            {
                                <a asp-controller="SavedJobs" asp-action="Create" asp-route-jobId="@Model.Id" class="btn btn-outline-primary px-3">
                                    <i class="bi bi-bookmark-plus"></i> Save Job
                                </a>
                            }
                            if (!hasApplied)
                            {
                                <a asp-controller="JobApplications" asp-action="Create" asp-route-jobId="@Model.Id" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                    <i class="bi bi-send-fill"></i> Apply Now
                                </a>
                            }
                            else
                            {
                                var userAppId = ViewData["UserApplicationId"];
                                if (userAppId != null)
                                {
                                    <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@userAppId" class="btn btn-success px-4 fw-semibold shadow-sm" title="Click to view your application status">
                                        <i class="bi bi-check-circle-fill"></i> Applied (View Status)
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-success px-4" disabled="disabled">
                                        <i class="bi bi-check-circle-fill"></i> Applied
                                    </button>
                                }
                            }
                        }
                        else if (!isRecruiter && !isAdmin)
                        {
                            <!-- Guest / Not Logged In -->
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="bi bi-box-arrow-in-right"></i> Login to Apply
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary px-4">
                                Register
                            </a>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
