@model Job_InternshipPortal.Models.Job
@{
    ViewData["Title"] = "Edit Job";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card bg-white border rounded-3 shadow-sm p-4">
                <div class="card-body">
                    <h3 class="fw-bold text-dark mb-4">Edit Job</h3>

                    <form asp-controller="Jobs" asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <!-- Job Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">Job Title</label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Location -->
                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-semibold">Location</label>
                            <input asp-for="Location" class="form-control" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>

                        <!-- Job Type -->
                        <div class="mb-3">
                            <label asp-for="JobType" class="form-label fw-semibold">Job Type</label>
                            <select asp-for="JobType" class="form-select" asp-items="Html.GetEnumSelectList<JobType>()">
                            </select>
                            <span asp-validation-for="JobType" class="text-danger small"></span>
                        </div>

                        <!-- Salary -->
                        <div class="mb-3">
                            <label asp-for="Salary" class="form-label fw-semibold">Salary</label>
                            <input asp-for="Salary" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Salary" class="text-danger small"></span>
                        </div>

                        <!-- Application Deadline -->
                        <div class="mb-3">
                            <label asp-for="LastDate" class="form-label fw-semibold">Application Deadline</label>
                            <input asp-for="LastDate" type="date" class="form-control" value="@Model.LastDate.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="LastDate" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Job Status</label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<JobStatus>()">
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- Requirements -->
                        <div class="mb-4">
                            <label asp-for="Requirements" class="form-label fw-semibold">Requirements</label>
                            <textarea asp-for="Requirements" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Requirements" class="text-danger small"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                Save Changes
                            </button>
                            <a href="@(User.IsInRole(UserRoles.Admin) ? Url.Action("Jobs", "Admin") : Url.Action("Index", "Jobs"))" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
