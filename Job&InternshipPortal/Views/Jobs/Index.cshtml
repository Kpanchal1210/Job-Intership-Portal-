@model IEnumerable<Job_InternshipPortal.Models.Job>
@{
    var isRecruiter = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    var isJobSeeker = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("JobSeeker") || User.IsInRole(UserRoles.JobSeeker));

    ViewData["Title"] = isRecruiter ? "My Jobs" : "Find Jobs & Internships";

    var currentUserId = User.Identity != null && User.Identity.IsAuthenticated
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        : null;

    var recruiterJobs = Model != null
        ? Model.Where(j => j.Company != null && (j.Company.RecruiterId == currentUserId || (j.Company.Recruiter != null && j.Company.Recruiter.UserName == User.Identity?.Name))).ToList()
        : new List<Job_InternshipPortal.Models.Job>();
    var jobsList = isRecruiter ? recruiterJobs : (Model?.ToList() ?? new List<Job_InternshipPortal.Models.Job>());

    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentJobType = ViewData["CurrentJobType"] as JobType?;
    var currentLocation = ViewData["CurrentLocation"] as string;
    var hasActiveFilters = !string.IsNullOrWhiteSpace(currentSearch) || currentJobType.HasValue || !string.IsNullOrWhiteSpace(currentLocation);

    var appliedJobMap = ViewBag.AppliedJobMap as Dictionary<int, int>;
    var savedJobIds = ViewBag.SavedJobIds as List<int>;
}

<div class="container py-4">
    @if (isRecruiter)
    {
        <!-- Recruiter: My Jobs -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">My Job Listings</h2>
                <p class="text-muted mb-0">Manage all job postings created by your organization.</p>
            </div>
            <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle"></i> Post New Job
            </a>
        </div>

        @if (jobsList.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                @foreach (var job in jobsList)
                {
                    var statusBadge = job.Status switch
                    {
                        JobStatus.Approved => "badge-status-approved",
                        JobStatus.Rejected => "badge-status-rejected",
                        JobStatus.Closed   => "badge-status-closed",
                        _                  => "badge-status-pending"
                    };

                    <div class="col">
                        <div class="job-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge-status @statusBadge">
                                    @job.Status
                                </span>
                                <span class="badge bg-light text-dark border small">
                                    @(job.JobType == JobType.FullTime ? "Full Time" : job.JobType == JobType.PartTime ? "Part Time" : "Internship")
                                </span>
                            </div>

                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="job-card-title mt-2">
                                @job.Title
                            </a>

                            <div class="text-muted small mb-2">
                                <i class="bi bi-geo-alt text-primary"></i> @(job.Location ?? "Not Specified")
                            </div>

                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @job.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3 pt-2 border-top">
                                <div>
                                    <i class="bi bi-cash-stack text-success"></i>
                                    <span class="job-salary-tag ms-1">@(job.Salary.HasValue ? $"₹{job.Salary.Value:N0}" : "Unspecified")</span>
                                </div>
                                <div>
                                    <i class="bi bi-people-fill text-primary"></i>
                                    <span class="ms-1">@(job.JobApplications?.Count ?? 0) Applicants</span>
                                </div>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex gap-2">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a asp-controller="Jobs" asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-secondary btn-sm flex-fill">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="Jobs" asp-action="Delete" asp-route-id="@job.Id" class="btn btn-outline-danger btn-sm flex-fill">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border rounded-4 shadow-sm p-5 text-center bg-white">
                <i class="bi bi-briefcase text-muted fs-1 mb-2"></i>
                <h4 class="fw-bold text-dark">No Jobs Posted Yet</h4>
                <p class="text-muted mb-4">You haven't created any job openings for your company. Start reaching qualified candidates today!</p>
                <div>
                    <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-plus-circle"></i> Post Your First Job
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Job Seeker & Guest: Find Jobs & Internships -->
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Find Jobs &amp; Internships</h2>
            <p class="text-muted">Browse approved opportunities from verified companies.</p>
        </div>

        <!-- Comprehensive Search & Filter UI -->
        <div class="card border rounded-4 shadow-sm p-3 p-md-4 bg-white mb-4">
            <form asp-controller="Jobs" asp-action="Index" method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchString" class="form-control border-start-0" placeholder="Title, skill, or company..." value="@currentSearch" />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-briefcase text-muted"></i></span>
                            <select name="jobType" class="form-select border-start-0">
                                <option value="">All Job Types</option>
                                <option value="@JobType.FullTime" selected="@(currentJobType == JobType.FullTime)">Full Time</option>
                                <option value="@JobType.PartTime" selected="@(currentJobType == JobType.PartTime)">Part Time</option>
                                <option value="@JobType.Internship" selected="@(currentJobType == JobType.Internship)">Internship</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                            <input type="text" name="location" class="form-control border-start-0" placeholder="Location / City..." value="@currentLocation" />
                        </div>
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button class="btn btn-primary flex-fill fw-semibold" type="submit">
                            <i class="bi bi-funnel-fill"></i> Filter
                        </button>
                        @if (hasActiveFilters)
                        {
                            <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>

        <!-- Jobs Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var job in Model)
                {
                    var companyInitial = !string.IsNullOrWhiteSpace(job.Company?.CompanyName)
                        ? job.Company.CompanyName.Substring(0, 1).ToUpper()
                        : "C";
                    var typeBadgeClass = job.JobType switch
                    {
                        JobType.Internship => "badge-internship",
                        JobType.PartTime   => "badge-parttime",
                        _                  => "badge-fulltime"
                    };

                    int existingAppId = 0;
                    var hasApplied = appliedJobMap != null && appliedJobMap.TryGetValue(job.Id, out existingAppId);
                    var hasSaved = savedJobIds != null && savedJobIds.Contains(job.Id);

                    <div class="col">
                        <div class="job-card">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <div class="job-company-avatar">
                                    @companyInitial
                                </div>
                                <div class="overflow-hidden">
                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="job-card-title text-truncate" title="@job.Title">
                                        @job.Title
                                    </a>
                                    <div class="job-company-name">
                                        <i class="bi bi-building"></i> @(job.Company?.CompanyName ?? "Verified Company")
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 flex-wrap mb-3">
                                <span class="badge-job-type @typeBadgeClass">
                                    <i class="bi bi-briefcase"></i> @(job.JobType == JobType.FullTime ? "Full Time" : job.JobType == JobType.PartTime ? "Part Time" : "Internship")
                                </span>
                                @if (!string.IsNullOrWhiteSpace(job.Location))
                                {
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-geo-alt text-primary"></i> @job.Location
                                    </span>
                                }
                                @if (hasApplied)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">
                                        <i class="bi bi-check-circle-fill"></i> Applied
                                    </span>
                                }
                            </div>

                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @job.Description
                            </p>

                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3 pt-2 border-top">
                                <div>
                                    <i class="bi bi-cash-stack text-success"></i>
                                    <span class="job-salary-tag ms-1">
                                        @(job.Salary.HasValue ? $"₹{job.Salary.Value:N0}" : "Competitive")
                                    </span>
                                </div>
                                <div>
                                    <i class="bi bi-calendar-event text-secondary"></i>
                                    <span class="ms-1">Apply by @job.LastDate.ToString("MMM d, yyyy")</span>
                                </div>
                            </div>

                            <div class="job-card-actions">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm flex-fill me-2">
                                    View Details
                                </a>
                                @if (isJobSeeker)
                                {
                                    if (hasSaved)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="Job Saved">
                                            <i class="bi bi-bookmark-check-fill text-success"></i> Saved
                                        </button>
                                    }
                                    else
                                    {
                                        <a asp-controller="SavedJobs" asp-action="Create" asp-route-jobId="@job.Id" class="btn btn-outline-secondary btn-sm" title="Save Job">
                                            <i class="bi bi-bookmark-plus"></i> Save
                                        </a>
                                    }

                                    if (hasApplied)
                                    {
                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@existingAppId" class="btn btn-success btn-sm flex-fill ms-2 fw-semibold" title="You have already applied. Click to view status.">
                                            <i class="bi bi-check-circle-fill"></i> Applied
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="JobApplications" asp-action="Create" asp-route-jobId="@job.Id" class="btn btn-primary btn-sm flex-fill ms-2">
                                            Apply
                                        </a>
                                    }
                                }
                                else if (!User.Identity?.IsAuthenticated == true)
                                {
                                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Jobs", new { id = job.Id })" class="btn btn-primary btn-sm flex-fill">
                                        Login to Apply
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border rounded-4 shadow-sm p-5 text-center bg-white">
                <i class="bi bi-search text-muted fs-1 mb-2"></i>
                <h4 class="fw-bold text-dark">No Jobs Found</h4>
                <p class="text-muted mb-3">We couldn't find any job or internship openings matching your search criteria.</p>
                <div>
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary btn-sm px-4">
                        Reset Filters
                    </a>
                </div>
            </div>
        }
    }
</div>
