@model Job_InternshipPortal.Models.SavedJob
@{
    ViewData["Title"] = "Remove Saved Job";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card bg-white border rounded-3 shadow-sm p-4 text-center">
                <div class="card-body">
                    <h3 class="fw-bold text-danger mb-3">Remove Saved Job</h3>
                    <p class="text-muted mb-3">Are you sure you want to remove this job from your saved jobs?</p>

                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h5 class="fw-bold text-dark mb-1">@(Model.Job?.Title ?? "Job")</h5>
                        <p class="text-secondary small mb-0">@(Model.Job?.Company?.CompanyName ?? "Company")</p>
                    </div>

                    <form asp-controller="SavedJobs" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Remove
                            </button>
                            <a asp-controller="SavedJobs" asp-action="Index" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
