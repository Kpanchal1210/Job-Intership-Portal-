@model Job_InternshipPortal.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home - Job & Internship Portal";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var isAdmin = isAuthenticated && User.IsInRole(UserRoles.Admin);
    var isRecruiter = isAuthenticated && (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    var isJobSeeker = isAuthenticated && (User.IsInRole("JobSeeker") || User.IsInRole(UserRoles.JobSeeker));
}

<!-- Role-Specific Welcome Header if Authenticated -->
@if (isAuthenticated)
{
    <div class="container pt-4">
        @if (isAdmin)
        {
            <div class="card border-0 bg-primary text-white rounded-3 shadow-sm p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white text-primary fw-bold px-2 py-1"><i class="bi bi-shield-check"></i> Administrator Portal</span>
                        </div>
                        <h2 class="fw-bold mb-1">Welcome, System Administrator!</h2>
                        <p class="mb-0 opacity-75">You have full governance over users, companies, job approvals, and placement metrics.</p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-light text-primary fw-semibold">
                            <i class="bi bi-speedometer2"></i> Admin Dashboard
                        </a>
                        <a asp-controller="Admin" asp-action="Jobs" class="btn btn-outline-light">
                            <i class="bi bi-briefcase"></i> Manage Jobs
                        </a>
                    </div>
                </div>
            </div>
        }
        else if (isRecruiter)
        {
            <div class="card border-0 bg-primary text-white rounded-3 shadow-sm p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white text-primary fw-bold px-2 py-1"><i class="bi bi-building"></i> Recruiter Portal</span>
                        </div>
                        <h2 class="fw-bold mb-1">Welcome, @(User.Identity?.Name?.Split('@')[0] ?? "Recruiter")!</h2>
                        <p class="mb-0 opacity-75">Manage your job openings, screen applications, and coordinate candidate interviews.</p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Companies" asp-action="Dashboard" class="btn btn-light text-primary fw-semibold">
                            <i class="bi bi-speedometer2"></i> Recruiter Dashboard
                        </a>
                        <a asp-controller="Jobs" asp-action="Create" class="btn btn-outline-light">
                            <i class="bi bi-plus-circle"></i> Post New Job
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 bg-primary text-white rounded-3 shadow-sm p-4 mb-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-white text-primary fw-bold px-2 py-1"><i class="bi bi-mortarboard"></i> Candidate Portal</span>
                        </div>
                        <h2 class="fw-bold mb-1">Welcome, @(User.Identity?.Name?.Split('@')[0] ?? "Job Seeker")!</h2>
                        <p class="mb-0 opacity-75">Explore exciting jobs and internships, submit resumes, and track your interview schedules.</p>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="JobApplications" asp-action="Dashboard" class="btn btn-light text-primary fw-semibold">
                            <i class="bi bi-speedometer2"></i> My Dashboard
                        </a>
                        <a asp-controller="JobApplications" asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-file-earmark-check"></i> My Applications
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Modern Hero Section (Equal Elegance for Guests, Job Seekers, Companies, and Admins) -->
<section class="portal-hero">
    <div class="container text-center position-relative" style="z-index: 2;">
        <span class="hero-tag">
            <i class="bi bi-stars text-warning"></i> Next-Gen Career &amp; Internship Ecosystem
        </span>
        <h1>
            Find Your Next <span class="hero-gradient-text">Opportunity</span> Today
        </h1>
        <p class="lead">
            Discover verified jobs, top student internships, and leading companies. Apply with one click, manage recruitment pipelines, or oversee institutional placements.
        </p>

        <!-- Live Hero Search Form -->
        <div class="hero-search-card text-start">
            <form asp-controller="Jobs" asp-action="Index" method="get">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search text-primary"></i></span>
                            <input type="text" name="searchString" class="form-control" placeholder="Job title, keywords, or company..." />
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-briefcase text-primary"></i></span>
                            <select name="jobType" class="form-select">
                                <option value="">All Job Types</option>
                                <option value="@JobType.FullTime">Full Time</option>
                                <option value="@JobType.PartTime">Part Time</option>
                                <option value="@JobType.Internship">Internship</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt text-primary"></i></span>
                            <input type="text" name="location" class="form-control" placeholder="City or location..." />
                        </div>
                    </div>
                    <div class="col-12 col-md-2 d-grid">
                        <button type="submit" class="btn btn-portal-primary py-2 fw-semibold">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Quick Trending Keywords -->
        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap mt-3 text-secondary small">
            <span class="text-white-50"><i class="bi bi-lightning-charge-fill text-warning"></i> Trending:</span>
            <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Software" class="badge bg-white bg-opacity-10 text-white text-decoration-none px-3 py-2 border border-light border-opacity-10">Software Engineer</a>
            <a asp-controller="Jobs" asp-action="Index" asp-route-jobType="@JobType.Internship" class="badge bg-white bg-opacity-10 text-white text-decoration-none px-3 py-2 border border-light border-opacity-10">Internships</a>
            <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Developer" class="badge bg-white bg-opacity-10 text-white text-decoration-none px-3 py-2 border border-light border-opacity-10">Full Stack</a>
            <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Remote" class="badge bg-white bg-opacity-10 text-white text-decoration-none px-3 py-2 border border-light border-opacity-10">Remote</a>
        </div>

        <!-- Live Platform Stats Grid (Matching Dashboards) -->
        <div class="hero-stats">
            <div class="hero-stat-item">
                <div class="stat-num">@Model.TotalJobs</div>
                <div class="stat-label">Active Jobs</div>
            </div>
            <div class="hero-stat-item">
                <div class="stat-num">@Model.TotalInternships</div>
                <div class="stat-label">Internship Openings</div>
            </div>
            <div class="hero-stat-item">
                <div class="stat-num">@Model.TotalCompanies</div>
                <div class="stat-label">Partner Companies</div>
            </div>
            <div class="hero-stat-item">
                <div class="stat-num">@Model.TotalApplications</div>
                <div class="stat-label">Applications Placed</div>
            </div>
        </div>
    </div>
</section>

<!-- Main Body Content -->
<div class="container py-5">

    <!-- Three Platform Pillars: Equal Parity for Job Seeker, Company, and Admin -->
    <div class="text-center mb-5">
        <h2 class="section-title">Built for Everyone in the Hiring Ecosystem</h2>
        <p class="section-subtitle">Dedicated portals and tailored toolsets whether you are seeking a job, hiring talent, or managing operations.</p>
    </div>

    <div class="row g-4 mb-5">
        <!-- Pillar 1: Job Seeker & Candidate Portal -->
        <div class="col-12 col-md-4">
            <div class="card h-100 bg-white border rounded-4 shadow-sm p-4 text-center transition-card">
                <div class="category-icon-box mx-auto mb-3" style="background: rgba(79, 70, 229, 0.1); color: var(--primary);">
                    <i class="bi bi-mortarboard fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Job Seekers &amp; Students</h4>
                <p class="text-muted small mb-4">
                    Explore curated full-time positions and internships. Upload your resume, apply with one click, save favorite roles, and track real-time application updates.
                </p>
                <div class="mt-auto d-grid gap-2">
                    <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-search"></i> Browse Jobs &amp; Internships
                    </a>
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-person-plus"></i> Join as Job Seeker
                        </a>
                    }
                    else if (isJobSeeker)
                    {
                        <a asp-controller="JobApplications" asp-action="Dashboard" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-speedometer2"></i> Open Candidate Dashboard
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Pillar 2: Company & Employer Portal -->
        <div class="col-12 col-md-4">
            <div class="card h-100 bg-white border rounded-4 shadow-sm p-4 text-center transition-card">
                <div class="category-icon-box mx-auto mb-3" style="background: rgba(14, 165, 233, 0.1); color: var(--secondary);">
                    <i class="bi bi-building fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Companies &amp; Recruiters</h4>
                <p class="text-muted small mb-4">
                    Showcase your company profile, post high-visibility job and internship vacancies, screen candidate resumes, and schedule online or in-person interviews seamlessly.
                </p>
                <div class="mt-auto d-grid gap-2">
                    <a asp-controller="Companies" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                        <i class="bi bi-buildings"></i> Company Directory
                    </a>
                    @if (!isAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-briefcase"></i> Register as Recruiter
                        </a>
                    }
                    else if (isRecruiter)
                    {
                        <a asp-controller="Companies" asp-action="Dashboard" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-speedometer2"></i> Open Recruiter Dashboard
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Pillar 3: Administrator & Institution Portal -->
        <div class="col-12 col-md-4">
            <div class="card h-100 bg-white border rounded-4 shadow-sm p-4 text-center transition-card">
                <div class="category-icon-box mx-auto mb-3" style="background: rgba(16, 185, 129, 0.1); color: var(--accent);">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">System Administrators</h4>
                <p class="text-muted small mb-4">
                    Full oversight of the portal ecosystem. Manage registered users, verify corporate profiles, review and approve/reject job postings, and audit placement data.
                </p>
                <div class="mt-auto d-grid gap-2">
                    @if (isAdmin)
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-speedometer2"></i> Open Admin Dashboard
                        </a>
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary fw-semibold">
                            <i class="bi bi-people"></i> Manage Users
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-semibold">
                            <i class="bi bi-box-arrow-in-right"></i> Administrator Login
                        </a>
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-primary fw-semibold shadow-sm">
                            <i class="bi bi-lock"></i> Admin Portal
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Featured Jobs Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="section-title mb-1">Featured Opportunities</h2>
            <p class="text-muted mb-0">Handpicked approved job openings and student internships from verified companies.</p>
        </div>
        <a asp-controller="Jobs" asp-action="Index" class="btn btn-portal-outline btn-sm">
            View All Jobs <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.FeaturedJobs != null && Model.FeaturedJobs.Any())
    {
        var appliedJobMap = ViewBag.AppliedJobMap as Dictionary<int, int>;

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var job in Model.FeaturedJobs)
            {
                var companyInitial = !string.IsNullOrWhiteSpace(job.Company?.CompanyName)
                    ? job.Company.CompanyName.Substring(0, 1).ToUpper()
                    : "C";
                var typeBadgeClass = job.JobType switch
                {
                    JobType.Internship => "badge-internship",
                    JobType.PartTime   => "badge-parttime",
                    _                  => "badge-fulltime"
                };
                int existingAppId = 0;
                var hasAppliedHome = appliedJobMap != null && appliedJobMap.TryGetValue(job.Id, out existingAppId);

                <div class="col">
                    <div class="job-card">
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="job-company-avatar">
                                @companyInitial
                            </div>
                            <div class="overflow-hidden">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="job-card-title text-truncate" title="@job.Title">
                                    @job.Title
                                </a>
                                <div class="job-company-name">
                                    <i class="bi bi-building"></i> @(job.Company?.CompanyName ?? "Verified Employer")
                                </div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <span class="badge-job-type @typeBadgeClass">
                                <i class="bi bi-briefcase"></i> @(job.JobType == JobType.FullTime ? "Full Time" : job.JobType == JobType.PartTime ? "Part Time" : "Internship")
                            </span>
                            @if (!string.IsNullOrWhiteSpace(job.Location))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-geo-alt text-primary"></i> @job.Location
                                </span>
                            }
                            @if (hasAppliedHome)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">
                                    <i class="bi bi-check-circle-fill"></i> Applied
                                </span>
                            }
                        </div>

                        <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                            @job.Description
                        </p>

                        <div class="d-flex justify-content-between align-items-center text-muted small mb-3 pt-2 border-top">
                            <div>
                                <i class="bi bi-cash-stack text-success"></i>
                                <span class="job-salary-tag ms-1">
                                    @(job.Salary.HasValue ? $"₹{job.Salary.Value:N0}" : "Competitive")
                                </span>
                            </div>
                            <div>
                                <i class="bi bi-calendar-event text-secondary"></i>
                                <span class="ms-1">Apply by @job.LastDate.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>

                        <div class="job-card-actions">
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm flex-fill me-2">
                                View Details
                            </a>
                            @if (isJobSeeker)
                            {
                                if (hasAppliedHome)
                                {
                                    <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@existingAppId" class="btn btn-success btn-sm flex-fill fw-semibold">
                                        <i class="bi bi-check-circle-fill"></i> Applied
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="JobApplications" asp-action="Create" asp-route-jobId="@job.Id" class="btn btn-primary btn-sm flex-fill">
                                        Apply Now
                                    </a>
                                }
                            }
                            else if (!isAuthenticated)
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Jobs", new { id = job.Id })" class="btn btn-primary btn-sm flex-fill">
                                    Apply
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border rounded-4 shadow-sm p-5 text-center bg-white mb-5">
            <i class="bi bi-briefcase text-muted fs-1 mb-2"></i>
            <h5 class="fw-bold text-dark">No Featured Jobs At The Moment</h5>
            <p class="text-muted small mb-3">Be the first company to post an opening and reach thousands of candidates!</p>
            <div>
                <a asp-controller="Jobs" asp-action="Create" class="btn btn-primary btn-sm px-4">
                    Post a Job
                </a>
            </div>
        </div>
    }

    <!-- Top Hiring Companies Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 mt-5">
        <div>
            <h2 class="section-title mb-1">Top Hiring Companies</h2>
            <p class="text-muted mb-0">Connect directly with verified corporate partners and industry leaders.</p>
        </div>
        <a asp-controller="Companies" asp-action="Index" class="btn btn-portal-outline btn-sm">
            Explore All Companies <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    @if (Model.FeaturedCompanies != null && Model.FeaturedCompanies.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
            @foreach (var company in Model.FeaturedCompanies)
            {
                var initial = !string.IsNullOrWhiteSpace(company.CompanyName)
                    ? company.CompanyName.Substring(0, 1).ToUpper()
                    : "C";
                var activeJobCount = company.Jobs?.Count(j => j.Status == JobStatus.Approved) ?? 0;

                <div class="col">
                    <div class="company-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="job-company-avatar" style="background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);">
                                @initial
                            </div>
                            <div class="overflow-hidden">
                                <h5 class="fw-bold text-dark mb-0 text-truncate">@company.CompanyName</h5>
                                <span class="text-muted small">
                                    <i class="bi bi-geo-alt"></i> @(company.Location ?? "Global / Remote")
                                </span>
                            </div>
                        </div>

                        <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                            @(string.IsNullOrWhiteSpace(company.Description) ? "Trusted hiring organization offering competitive career development." : company.Description)
                        </p>

                        <div class="d-flex justify-content-between align-items-center small text-secondary mb-3 pt-2 border-top">
                            <div>
                                <span class="badge bg-primary-subtle text-primary border">
                                    <i class="bi bi-briefcase-fill"></i> @activeJobCount Active @(activeJobCount == 1 ? "Job" : "Jobs")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(company.Website))
                            {
                                <a href="@company.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none small text-muted">
                                    <i class="bi bi-globe"></i> Website
                                </a>
                            }
                        </div>

                        <div class="mt-auto">
                            <a asp-controller="Companies" asp-action="Details" asp-route-id="@company.Id" class="btn btn-outline-primary btn-sm w-100">
                                View Company &amp; Openings
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Career Opportunities by Category -->
    <div class="mb-5 mt-5">
        <div class="text-center mb-4">
            <h2 class="section-title">Popular Career Tracks</h2>
            <p class="section-subtitle">Explore job listings tailored to your domain and interests.</p>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">
            <div class="col">
                <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Software" class="category-card">
                    <div class="category-icon-box" style="background: rgba(79, 70, 229, 0.1); color: var(--primary);">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Software &amp; IT</div>
                        <div class="text-muted small">Development &amp; Cloud</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Jobs" asp-action="Index" asp-route-jobType="@JobType.Internship" class="category-card">
                    <div class="category-icon-box" style="background: rgba(16, 185, 129, 0.1); color: var(--accent);">
                        <i class="bi bi-mortarboard"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Internships</div>
                        <div class="text-muted small">Student Traineeships</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Marketing" class="category-card">
                    <div class="category-icon-box" style="background: rgba(245, 158, 11, 0.1); color: var(--warning);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Marketing &amp; Sales</div>
                        <div class="text-muted small">Growth &amp; Outreach</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="Remote" class="category-card">
                    <div class="category-icon-box" style="background: rgba(14, 165, 233, 0.1); color: var(--secondary);">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Remote Roles</div>
                        <div class="text-muted small">Work From Anywhere</div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <!-- Student & Recruiter Call To Action Banner -->
    <div class="student-cta-section">
        <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
            <div class="col-12 col-lg-8">
                <span class="badge bg-white bg-opacity-20 text-white px-3 py-1 mb-3">
                    <i class="bi bi-rocket-takeoff-fill text-warning"></i> Accelerate Your Career
                </span>
                <h2 class="display-6 fw-bold mb-3">Ready to find your dream job or hire exceptional talent?</h2>
                <p class="lead mb-0 text-white-50" style="max-width: 650px;">
                    Join thousands of job seekers, top tier employers, and educational institutions already growing on Job &amp; Internship Portal.
                </p>
            </div>
            <div class="col-12 col-lg-4 text-lg-end">
                @if (!isAuthenticated)
                {
                    <div class="d-flex flex-column flex-sm-row justify-content-lg-end gap-2">
                        <a asp-controller="Account" asp-action="Register" class="btn btn-light text-primary btn-lg px-4 fw-bold shadow">
                            Get Started Free
                        </a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-4 fw-semibold">
                            Sign In
                        </a>
                    </div>
                }
                else
                {
                    <a asp-controller="@(isAdmin ? "Admin" : isRecruiter ? "Companies" : "JobApplications")" asp-action="Dashboard" class="btn btn-light text-primary btn-lg px-4 fw-bold shadow">
                        Go To My Dashboard
                    </a>
                }
            </div>
        </div>
    </div>

</div>
