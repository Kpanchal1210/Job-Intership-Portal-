@model IEnumerable<Job_InternshipPortal.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Manage Users</h2>
            <p class="text-muted mb-0">View all registered users and manage accounts across the platform.</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
            &larr; Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card bg-white border rounded-3 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Name</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Email</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Role</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-semibold text-dark">
                                    @user.FullName
                                    @if (user.IsCurrentAdmin)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border ms-2 small">You</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @user.Email
                                </td>
                                <td class="py-3 px-4">
                                    @foreach (var role in user.Roles)
                                    {
                                        var roleDisplayName = role == UserRoles.Recruiter ? "Company" : role == UserRoles.JobSeeker ? "Job Seeker" : role;
                                        <span class="badge @(role == UserRoles.Admin ? "bg-danger-subtle text-danger-emphasis" : role == UserRoles.Recruiter ? "bg-info-subtle text-info-emphasis" : "bg-secondary-subtle text-secondary-emphasis") border px-2 py-1 me-1">
                                            @roleDisplayName
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-2">
                                        <a asp-controller="Admin" asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">
                                            View
                                        </a>

                                        @if (!user.IsCurrentAdmin)
                                        {
                                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete user \'@user.FullName\'? This will also remove any associated jobs, applications, or companies.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                                    Delete
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled title="You cannot delete your own account">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white border rounded-3 shadow-sm p-4">
            <p class="lead text-muted mb-0">No users found.</p>
        </div>
    }
</div>
