@model Job_InternshipPortal.Models.ApplicationUser
@{
    ViewData["Title"] = "User Details";
    var roles = ViewBag.Roles as IList<string> ?? new List<string>();
    var isCurrentAdmin = User.Identity?.Name == Model.UserName;
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card bg-white border rounded-3 shadow-sm p-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="fw-bold text-dark mb-0">User Profile Details</h3>
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary btn-sm">
                            &larr; Back to Users
                        </a>
                    </div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Full Name</h6>
                        <p class="text-dark fs-5 fw-semibold mb-0">@Model.FullName</p>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Email</h6>
                        <p class="text-dark fs-6 mb-0">@Model.Email</p>
                    </div>

                    <!-- User Name -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Username</h6>
                        <p class="text-dark fs-6 mb-0">@Model.UserName</p>
                    </div>

                    <!-- Assigned Roles -->
                    <div class="mb-3">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Assigned Role(s)</h6>
                        <div class="mt-1">
                            @foreach (var role in roles)
                            {
                                var roleDisplayName = role == UserRoles.Recruiter ? "Company" : role == UserRoles.JobSeeker ? "Job Seeker" : role;
                                <span class="badge @(role == UserRoles.Admin ? "bg-danger" : role == UserRoles.Recruiter ? "bg-info text-dark" : "bg-primary") px-3 py-2 fs-6 me-1">
                                    @roleDisplayName
                                </span>
                            }
                        </div>
                    </div>

                    @if (Model.Company != null)
                    {
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-dark mb-1">Associated Company</h6>
                            <p class="mb-1"><strong>Company:</strong> @Model.Company.CompanyName</p>
                            <p class="mb-0"><strong>Location:</strong> @Model.Company.Location</p>
                        </div>
                    }

                    @if (Model.JobApplications != null && Model.JobApplications.Any())
                    {
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <h6 class="fw-bold text-dark mb-1">Job Applications</h6>
                            <p class="mb-0">Total Applications Submitted: <strong>@Model.JobApplications.Count</strong></p>
                        </div>
                    }

                    <!-- Actions -->
                    <div class="pt-3 border-top d-flex gap-2 align-items-center">
                        <a asp-controller="Admin" asp-action="Users" class="btn btn-secondary px-4">
                            Back to Users
                        </a>
                        @if (!isCurrentAdmin)
                        {
                            <form asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete user \'@Model.FullName\'? This will also remove any associated jobs, applications, or companies.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-trash"></i> Delete User
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
