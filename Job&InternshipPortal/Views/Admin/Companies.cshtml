@model IEnumerable<Job_InternshipPortal.Models.Company>
@{
    ViewData["Title"] = "Manage Companies";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Manage Companies</h2>
            <p class="text-muted mb-0">Overview of all companies registered by recruiters across the platform.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Companies" asp-action="Create" class="btn btn-primary">
                + Add Company
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
                &larr; Dashboard
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card bg-white border rounded-3 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Company Name</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Description</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Location</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Recruiter / Owner</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-center">Jobs</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-semibold text-dark">
                                    @item.CompanyName
                                </td>
                                <td class="py-3 px-4 text-muted small" style="max-width: 280px;">
                                    @(item.Description != null && item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @item.Location
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @(item.Recruiter?.FullName ?? item.Recruiter?.UserName ?? "N/A")
                                </td>
                                <td class="py-3 px-4 text-center">
                                    <span class="badge bg-light text-dark border">
                                        @(item.Jobs?.Count ?? 0)
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Companies" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                            View
                                        </a>
                                        <a asp-controller="Companies" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>
                                        <a asp-controller="Companies" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white border rounded-3 shadow-sm p-4">
            <p class="lead text-muted mb-0">No companies found.</p>
        </div>
    }
</div>
