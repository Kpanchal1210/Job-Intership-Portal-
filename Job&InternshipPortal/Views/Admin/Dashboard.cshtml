@model Job_InternshipPortal.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary text-white fw-bold px-2 py-1"><i class="bi bi-shield-check"></i> System Control</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Admin Dashboard</h2>
            <p class="text-muted small mb-0">Overview and control center for system data, users, and operations.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-house"></i> Public Home
            </a>
            <a asp-controller="Admin" asp-action="Jobs" class="btn btn-primary btn-sm">
                <i class="bi bi-briefcase"></i> Review Jobs
            </a>
        </div>
    </div>

    @if (Model.PendingJobs > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center justify-content-between shadow-sm rounded-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                <div>
                    <strong>Action Required:</strong> You have <strong>@Model.PendingJobs pending @(Model.PendingJobs == 1 ? "job" : "jobs")</strong> waiting for administrative approval.
                </div>
            </div>
            <a asp-controller="Admin" asp-action="Jobs" class="btn btn-warning btn-sm fw-semibold">
                Review Pending Jobs &rarr;
            </a>
        </div>
    }

    <!-- 4 Summary Stat Cards -->
    <div class="row g-4 mb-4">
        <!-- Users Card -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card bg-white border rounded-4 shadow-sm h-100 p-4 transition-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-secondary text-uppercase fw-bold small">Total Users</span>
                    <div class="category-icon-box" style="width:40px; height:40px; font-size:1.1rem; background:rgba(79, 70, 229, 0.1); color:var(--primary);">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <h2 class="display-5 fw-bold text-dark mb-3">@Model.TotalUsers</h2>
                <div class="mt-auto pt-2 border-top">
                    <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-primary btn-sm w-100">
                        Manage Users
                    </a>
                </div>
            </div>
        </div>

        <!-- Companies Card -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card bg-white border rounded-4 shadow-sm h-100 p-4 transition-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-secondary text-uppercase fw-bold small">Companies</span>
                    <div class="category-icon-box" style="width:40px; height:40px; font-size:1.1rem; background:rgba(14, 165, 233, 0.1); color:var(--secondary);">
                        <i class="bi bi-buildings"></i>
                    </div>
                </div>
                <h2 class="display-5 fw-bold text-dark mb-3">@Model.TotalCompanies</h2>
                <div class="mt-auto pt-2 border-top">
                    <a asp-controller="Admin" asp-action="Companies" class="btn btn-outline-primary btn-sm w-100">
                        Manage Companies
                    </a>
                </div>
            </div>
        </div>

        <!-- Jobs Card -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card bg-white border rounded-4 shadow-sm h-100 p-4 transition-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-secondary text-uppercase fw-bold small">Total Jobs</span>
                    <div class="category-icon-box" style="width:40px; height:40px; font-size:1.1rem; background:rgba(16, 185, 129, 0.1); color:var(--accent);">
                        <i class="bi bi-briefcase"></i>
                    </div>
                </div>
                <h2 class="display-5 fw-bold text-dark mb-3">@Model.TotalJobs</h2>
                <div class="mt-auto pt-2 border-top">
                    <a asp-controller="Admin" asp-action="Jobs" class="btn btn-outline-primary btn-sm w-100">
                        Manage Jobs
                    </a>
                </div>
            </div>
        </div>

        <!-- Applications Card -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card bg-white border rounded-4 shadow-sm h-100 p-4 transition-card">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="text-secondary text-uppercase fw-bold small">Applications</span>
                    <div class="category-icon-box" style="width:40px; height:40px; font-size:1.1rem; background:rgba(245, 158, 11, 0.1); color:var(--warning);">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                </div>
                <h2 class="display-5 fw-bold text-dark mb-3">@Model.TotalApplications</h2>
                <div class="mt-auto pt-2 border-top">
                    <a asp-controller="Admin" asp-action="Applications" class="btn btn-outline-primary btn-sm w-100">
                        View Applications
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Administrative Quick Links -->
    <div class="card bg-white border rounded-4 shadow-sm p-4">
        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-sliders text-primary"></i> Administrative Quick Controls</h5>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
            <div class="col">
                <a asp-controller="Admin" asp-action="Users" class="category-card p-3">
                    <div class="category-icon-box" style="width:42px; height:42px; font-size:1.1rem; background:rgba(79, 70, 229, 0.1); color:var(--primary);">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">User Accounts</div>
                        <div class="text-muted small">Candidates &amp; Companies</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Admin" asp-action="Companies" class="category-card p-3">
                    <div class="category-icon-box" style="width:42px; height:42px; font-size:1.1rem; background:rgba(14, 165, 233, 0.1); color:var(--secondary);">
                        <i class="bi bi-buildings-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Companies</div>
                        <div class="text-muted small">Verify Profiles</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Admin" asp-action="Jobs" class="category-card p-3">
                    <div class="category-icon-box" style="width:42px; height:42px; font-size:1.1rem; background:rgba(16, 185, 129, 0.1); color:var(--accent);">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Job Approvals</div>
                        <div class="text-muted small">Approve &amp; Reject</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Admin" asp-action="Applications" class="category-card p-3">
                    <div class="category-icon-box" style="width:42px; height:42px; font-size:1.1rem; background:rgba(245, 158, 11, 0.1); color:var(--warning);">
                        <i class="bi bi-file-earmark-check-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Applications</div>
                        <div class="text-muted small">Audit Submissions</div>
                    </div>
                </a>
            </div>
            <div class="col">
                <a asp-controller="Interviews" asp-action="Index" class="category-card p-3">
                    <div class="category-icon-box" style="width:42px; height:42px; font-size:1.1rem; background:rgba(6, 182, 212, 0.1); color:#0891b2;">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">Interviews</div>
                        <div class="text-muted small">Schedule &amp; Audits</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
