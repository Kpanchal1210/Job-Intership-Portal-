@model IEnumerable<Job_InternshipPortal.Models.JobApplication>
@{
    ViewData["Title"] = "View Applications";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Applications Overview</h2>
            <p class="text-muted mb-0">Monitor all candidate applications submitted across all job listings.</p>
        </div>
        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
            &larr; Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card bg-white border rounded-3 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Candidate</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Job</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Company</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Applied Date</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Status</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-3 px-4 fw-semibold text-dark">
                                    @(item.Applicant?.FullName ?? item.Applicant?.UserName ?? "Candidate")
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @(item.Job?.Title ?? "Job")
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @(item.Job?.Company?.CompanyName ?? "Company")
                                </td>
                                <td class="py-3 px-4 text-muted">
                                    @item.AppliedDate.ToString("dd/MM/yyyy")
                                </td>
                                <td class="py-3 px-4">
                                    @{
                                        var (statusBg, statusFg) = item.Status switch
                                        {
                                            ApplicationStatus.Selected    => ("bg-success-subtle", "text-success-emphasis"),
                                            ApplicationStatus.Rejected    => ("bg-danger-subtle",  "text-danger-emphasis"),
                                            ApplicationStatus.Shortlisted => ("bg-warning-subtle", "text-warning-emphasis"),
                                            ApplicationStatus.Interview   => ("bg-info-subtle",    "text-info-emphasis"),
                                            ApplicationStatus.UnderReview => ("bg-primary-subtle", "text-primary-emphasis"),
                                            _                             => ("bg-secondary-subtle","text-secondary-emphasis")
                                        };
                                    }
                                    <span class="badge @statusBg @statusFg border px-2 py-1">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                            View Details
                                        </a>
                                        @if (item.Status == ApplicationStatus.Interview && item.Interviews != null && item.Interviews.Any())
                                        {
                                            var interview = item.Interviews.First();
                                            <a asp-controller="Interviews" asp-action="Details" asp-route-id="@interview.Id" class="btn btn-outline-info btn-sm">
                                                View Interview
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white border rounded-3 shadow-sm p-4">
            <p class="lead text-muted mb-0">No job applications submitted yet.</p>
        </div>
    }
</div>