@model Job_InternshipPortal.Models.Company
@{
    var isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole(UserRoles.Admin);
    var isRecruiter = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    ViewData["Title"] = Model.CompanyName + " - Company Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card bg-white border rounded-3 shadow-sm p-4">
                <div class="card-body">
                    <!-- Company Name Header -->
                    <h2 class="fw-bold text-dark mb-4">@Model.CompanyName</h2>

                    <!-- Location -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Location</h6>
                        <p class="text-dark fs-5 mb-0">@(Model.Location ?? "Not Specified")</p>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark border-bottom pb-2">Description</h6>
                        <p class="text-muted" style="white-space: pre-line;">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                        </p>
                    </div>

                    <!-- Website -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-secondary text-uppercase small mb-1">Website</h6>
                        <p class="mb-0">
                            @if (!string.IsNullOrEmpty(Model.Website))
                            {
                                <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none fs-6">
                                    @Model.Website
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not Specified</span>
                            }
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="pt-3 border-top d-flex flex-wrap gap-2">
                        @if (isAdmin)
                        {
                            <a asp-controller="Companies" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                                Edit Company
                            </a>
                            <a asp-controller="Companies" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                                Delete
                            </a>
                            <a asp-controller="Admin" asp-action="Companies" class="btn btn-secondary px-4">
                                Back to Companies
                            </a>
                        }
                        else if (isRecruiter)
                        {
                            <a asp-controller="Companies" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4">
                                Edit Profile
                            </a>
                            <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="@Model.CompanyName" class="btn btn-outline-primary px-4">
                                View Jobs
                            </a>
                            <a asp-controller="Companies" asp-action="Index" class="btn btn-secondary px-4">
                                Back to Companies
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Jobs" asp-action="Index" asp-route-searchString="@Model.CompanyName" class="btn btn-primary px-4">
                                View Jobs
                            </a>
                            <a asp-controller="Companies" asp-action="Index" class="btn btn-secondary px-4">
                                Back to Companies
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
