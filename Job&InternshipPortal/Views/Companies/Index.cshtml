@model IEnumerable<Job_InternshipPortal.Models.Company>
@{
    var isRecruiter = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Company") || User.IsInRole("Recruiter") || User.IsInRole(UserRoles.Recruiter));
    ViewData["Title"] = isRecruiter ? "Company Profile" : "Explore Companies";

    var currentUserId = User.Identity != null && User.Identity.IsAuthenticated
        ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        : null;

    var myCompany = Model != null && isRecruiter
        ? Model.FirstOrDefault(c => (c.RecruiterId != null && c.RecruiterId == currentUserId) ||
                                    (c.Recruiter != null && c.Recruiter.UserName == User.Identity?.Name))
        : null;

    var currentSearch = ViewData["CurrentSearch"] as string;
}

<div class="container py-4">
    @if (isRecruiter)
    {
        <!-- Recruiter: Company Profile View -->
        @if (myCompany != null)
        {
            var companyInitial = !string.IsNullOrWhiteSpace(myCompany.CompanyName) ? myCompany.CompanyName.Substring(0, 1).ToUpper() : "C";
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8">
                    <div class="card bg-white border rounded-4 shadow-sm p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-4 pb-4 border-bottom">
                            <div class="job-company-avatar" style="width:60px; height:60px; font-size:1.5rem;">
                                @companyInitial
                            </div>
                            <div>
                                <h2 class="fw-bold text-dark mb-0">@myCompany.CompanyName</h2>
                                <span class="badge bg-primary-subtle text-primary border">
                                    <i class="bi bi-shield-check"></i> Registered Employer
                                </span>
                            </div>
                            <div class="ms-auto">
                                <a asp-controller="Companies" asp-action="Edit" asp-route-id="@myCompany.Id" class="btn btn-primary btn-sm px-3">
                                    <i class="bi bi-pencil"></i> Edit Profile
                                </a>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-sm-6">
                                <label class="fw-semibold text-secondary small text-uppercase">Location</label>
                                <p class="text-dark fs-6 mb-0">
                                    <i class="bi bi-geo-alt text-primary"></i> @(myCompany.Location ?? "Not Specified")
                                </p>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="fw-semibold text-secondary small text-uppercase">Website</label>
                                <p class="mb-0">
                                    @if (!string.IsNullOrEmpty(myCompany.Website))
                                    {
                                        <a href="@myCompany.Website" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none">
                                            <i class="bi bi-globe"></i> @myCompany.Website
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not Specified</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="fw-semibold text-secondary small text-uppercase">About Company</label>
                            <p class="text-muted mb-0" style="white-space: pre-line; line-height: 1.6;">
                                @(string.IsNullOrWhiteSpace(myCompany.Description) ? "No description provided." : myCompany.Description)
                            </p>
                        </div>

                        <div class="mb-4">
                            <label class="fw-semibold text-secondary small text-uppercase">Recruiter Contact</label>
                            <p class="text-dark mb-0">
                                <i class="bi bi-envelope text-primary"></i> @(myCompany.Recruiter?.Email ?? User.Identity?.Name ?? "Not Specified")
                            </p>
                        </div>

                        <div class="pt-3 border-top d-flex flex-wrap gap-2">
                            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary px-4">
                                <i class="bi bi-briefcase"></i> View My Jobs
                            </a>
                            <a asp-controller="Jobs" asp-action="Create" class="btn btn-outline-primary px-4">
                                <i class="bi bi-plus-circle"></i> Post New Job
                            </a>
                            <a asp-controller="Companies" asp-action="Dashboard" class="btn btn-outline-secondary px-4">
                                Dashboard
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card border rounded-4 shadow-sm p-5 text-center bg-white">
                <i class="bi bi-building text-muted fs-1 mb-2"></i>
                <h3 class="fw-bold text-dark mb-2">Create Your Company Profile</h3>
                <p class="lead text-muted mb-4">Set up your organization's presence before posting job opportunities and managing candidate pipelines.</p>
                <div>
                    <a asp-controller="Companies" asp-action="Create" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-plus-circle"></i> Create Company Profile
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <!-- Job Seeker & Guest: Explore Companies View -->
        <div class="text-center mb-4">
            <h2 class="fw-bold text-dark">Explore Verified Companies</h2>
            <p class="text-muted">Discover leading organizations hiring students and professionals.</p>
        </div>

        <!-- Search Bar -->
        <div class="card border rounded-4 shadow-sm p-3 bg-white mb-4">
            <form asp-controller="Companies" asp-action="Index" method="get">
                <div class="row g-2 align-items-center justify-content-center">
                    <div class="col-12 col-md-8">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="searchString" class="form-control border-start-0" placeholder="Search companies by name, location, or industry..." value="@currentSearch" />
                        </div>
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill fw-semibold">
                            <i class="bi bi-search"></i> Search
                        </button>
                        @if (!string.IsNullOrWhiteSpace(currentSearch))
                        {
                            <a asp-controller="Companies" asp-action="Index" class="btn btn-outline-secondary" title="Clear">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var company in Model)
                {
                    var initial = !string.IsNullOrWhiteSpace(company.CompanyName) ? company.CompanyName.Substring(0, 1).ToUpper() : "C";
                    var activeJobCount = company.Jobs?.Count(j => j.Status == JobStatus.Approved) ?? 0;

                    <div class="col">
                        <div class="company-card">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="job-company-avatar" style="background: linear-gradient(135deg, #0ea5e9 0%, #3b82f6 100%);">
                                    @initial
                                </div>
                                <div class="overflow-hidden">
                                    <h5 class="fw-bold text-dark mb-0 text-truncate">@company.CompanyName</h5>
                                    <span class="text-muted small">
                                        <i class="bi bi-geo-alt"></i> @(company.Location ?? "Global / Remote")
                                    </span>
                                </div>
                            </div>

                            <p class="text-muted small mb-3 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
                                @(string.IsNullOrWhiteSpace(company.Description) ? "Trusted hiring organization offering competitive career development." : company.Description)
                            </p>

                            <div class="d-flex justify-content-between align-items-center small text-secondary mb-3 pt-2 border-top">
                                <div>
                                    <span class="badge bg-primary-subtle text-primary border">
                                        <i class="bi bi-briefcase-fill"></i> @activeJobCount Active @(activeJobCount == 1 ? "Job" : "Jobs")
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(company.Website))
                                {
                                    <a href="@company.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none small text-muted">
                                        <i class="bi bi-globe"></i> Website
                                    </a>
                                }
                            </div>

                            <div class="mt-auto">
                                <a asp-controller="Companies" asp-action="Details" asp-route-id="@company.Id" class="btn btn-outline-primary btn-sm w-100">
                                    View Company &amp; Openings
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border rounded-4 shadow-sm p-5 text-center bg-white">
                <i class="bi bi-buildings text-muted fs-1 mb-2"></i>
                <h4 class="fw-bold text-dark">No Companies Found</h4>
                <p class="text-muted mb-3">No companies match your search criteria.</p>
                <div>
                    <a asp-controller="Companies" asp-action="Index" class="btn btn-outline-primary btn-sm px-4">
                        Reset Search
                    </a>
                </div>
            </div>
        }
    }
</div>
