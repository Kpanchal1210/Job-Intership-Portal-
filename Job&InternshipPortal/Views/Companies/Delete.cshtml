@model Job_InternshipPortal.Models.Company
@{
    ViewData["Title"] = "Delete Company";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card bg-white border rounded-3 shadow-sm p-4 text-center">
                <div class="card-body">
                    <h3 class="fw-bold text-danger mb-3">Delete Company</h3>
                    <p class="text-muted mb-3">Are you sure you want to delete:</p>

                    <h4 class="fw-bold text-dark mb-4">@Model.CompanyName?</h4>

                    <form asp-controller="Companies" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-2">
                            <button type="submit" class="btn btn-danger px-4">
                                Delete
                            </button>
                            <a href="@(User.IsInRole(UserRoles.Admin) ? Url.Action("Companies", "Admin") : Url.Action("Index", "Companies"))" class="btn btn-secondary px-4">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
