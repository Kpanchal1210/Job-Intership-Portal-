@model IEnumerable<Job_InternshipPortal.Models.JobApplication>
@using Job_InternshipPortal.Models
@{
    ViewData["Title"] = "Shortlisted Applicants";
    var selectedJobId = ViewBag.SelectedJobId as int?;
    var placedCandidates = ViewBag.PlacedCandidates as Dictionary<string, string>;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning-subtle text-warning-emphasis border fw-bold px-2 py-1">
                    <i class="bi bi-star-fill"></i> Recruitment Pipeline
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Shortlisted Applicants</h2>
            <p class="text-muted small mb-0">Candidates shortlisted for consideration. You can schedule interviews, make final selections, or reject.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Companies" asp-action="SelectedCandidates" class="btn btn-outline-success btn-sm">
                <i class="bi bi-check-circle-fill"></i> View Selected Candidates
            </a>
            <a asp-controller="Companies" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filter by Job Card -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-3 mb-4">
        <form asp-controller="Companies" asp-action="ShortlistedApplicants" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-secondary mb-1">Filter by Job Posting</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-briefcase text-muted"></i></span>
                    <select name="jobId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- All Company Jobs --</option>
                        @if (ViewBag.Jobs != null)
                        {
                            foreach (var item in (SelectList)ViewBag.Jobs)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-12 col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3 mt-md-4">
                    <i class="bi bi-funnel"></i> Apply Filter
                </button>
                @if (selectedJobId.HasValue && selectedJobId.Value > 0)
                {
                    <a asp-controller="Companies" asp-action="ShortlistedApplicants" class="btn btn-outline-secondary btn-sm mt-md-4">
                        Clear Filter
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Applicants List / Table -->
    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary">Candidate</th>
                            <th scope="col" class="py-3 px-3 fw-semibold text-secondary">Job Title</th>
                            <th scope="col" class="py-3 px-3 fw-semibold text-secondary">Applied Date</th>
                            <th scope="col" class="py-3 px-3 fw-semibold text-secondary">Interview Status</th>
                            <th scope="col" class="py-3 px-3 fw-semibold text-secondary">Resume</th>
                            <th scope="col" class="py-3 px-4 fw-semibold text-secondary text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hasInterview = item.Interviews != null && item.Interviews.Any();
                            var scheduledInterview = hasInterview ? item.Interviews!.First() : null;
                            var candidateName = item.Applicant?.FullName ?? item.Applicant?.UserName ?? "Applicant";
                            var jobTitle = item.Job?.Title ?? "Position";
                            string? placedTitle = null;
                            var isPlacedElsewhere = placedCandidates != null && placedCandidates.TryGetValue(item.ApplicantId, out placedTitle);

                            <tr>
                                <td class="py-3 px-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-primary-subtle text-primary fw-bold d-inline-flex align-items-center justify-content-center rounded-circle" style="width:36px; height:36px;">
                                            @(candidateName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@candidateName</div>
                                            <div class="small text-muted">@(item.Applicant?.Email ?? "")</div>
                                            @if (isPlacedElsewhere)
                                            {
                                                <span class="badge bg-secondary text-white small mt-1" title="Already selected for @placedTitle">
                                                    <i class="bi bi-lock-fill"></i> Placed Elsewhere
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-3">
                                    <div class="fw-semibold text-dark">@jobTitle</div>
                                    <div class="small text-muted">@(item.Job?.JobType.ToString() ?? "Full Time")</div>
                                </td>
                                <td class="py-3 px-3 text-muted">
                                    @item.AppliedDate.ToLocalTime().ToString("MMM d, yyyy")
                                </td>
                                <td class="py-3 px-3">
                                    @if (hasInterview && scheduledInterview != null)
                                    {
                                        <span class="badge bg-info-subtle text-info-emphasis border">
                                            <i class="bi bi-calendar-event"></i> @scheduledInterview.InterviewType
                                        </span>
                                        <div class="small text-muted mt-1">
                                            @scheduledInterview.InterviewDate.ToLocalTime().ToString("MMM d, h:mm tt")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis border">
                                            Not Scheduled
                                        </span>
                                    }
                                </td>
                                <td class="py-3 px-3">
                                    @if (!string.IsNullOrEmpty(item.ResumePath))
                                    {
                                        <a href="@item.ResumePath" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm" title="View Resume">
                                            <i class="bi bi-file-earmark-pdf text-danger"></i> Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td class="py-3 px-4 text-end">
                                    <div class="d-inline-flex gap-1 flex-wrap justify-content-end align-items-center">
                                        <a asp-controller="JobApplications" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>

                                        @if (isPlacedElsewhere)
                                        {
                                            <span class="badge bg-secondary text-white py-1 px-2 d-inline-flex align-items-center gap-1" title="Candidate placed in @placedTitle">
                                                <i class="bi bi-lock-fill"></i> Placed in @placedTitle
                                            </span>
                                        }
                                        else
                                        {
                                            @if (!hasInterview)
                                            {
                                                <a asp-controller="Interviews" asp-action="Create" asp-route-applicationId="@item.Id" class="btn btn-outline-info btn-sm" title="Schedule Interview">
                                                    <i class="bi bi-calendar-plus"></i> Interview
                                                </a>
                                            }
                                            else if (scheduledInterview != null)
                                            {
                                                <a asp-controller="Interviews" asp-action="Details" asp-route-id="@scheduledInterview.Id" class="btn btn-outline-info btn-sm" title="View Interview Details">
                                                    <i class="bi bi-calendar-check"></i> Interview
                                                </a>
                                            }

                                            <!-- Select Candidate Form with Confirmation Modal trigger -->
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#selectModal-@item.Id">
                                                <i class="bi bi-check-circle-fill"></i> Select
                                            </button>

                                            <!-- Reject Candidate Form with Confirmation Modal trigger -->
                                            <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                <i class="bi bi-x-circle"></i> Reject
                                            </button>
                                        }
                                    </div>

                                    @if (!isPlacedElsewhere)
                                    {
                                        <!-- Confirmation Modal for Select Candidate -->
                                        <div class="modal fade text-start" id="selectModal-@item.Id" tabindex="-1" aria-labelledby="selectModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <form asp-controller="Companies" asp-action="SelectCandidate" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold text-dark" id="selectModalLabel-@item.Id">
                                                                <i class="bi bi-check-circle-fill text-success me-2"></i> Confirm Final Selection
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body py-4">
                                                            <p class="mb-2">
                                                                Are you sure you want to select <strong>@candidateName</strong> as the final candidate for the position <strong>@jobTitle</strong>?
                                                            </p>
                                                            <div class="alert alert-success-subtle border text-success-emphasis small mb-0">
                                                                <i class="bi bi-info-circle-fill me-1"></i>
                                                                This will update the candidate's status to <strong>Selected</strong>, record the selection date, and notify the student on their dashboard.
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-success fw-semibold">
                                                                <i class="bi bi-check-circle-fill"></i> Yes, Select Candidate
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Confirmation Modal for Reject Candidate -->
                                        <div class="modal fade text-start" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <form asp-controller="Companies" asp-action="RejectCandidate" asp-route-id="@item.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-header border-0 pb-0">
                                                            <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel-@item.Id">
                                                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Rejection
                                                            </h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body py-4">
                                                            <p class="mb-0">
                                                                Are you sure you want to mark <strong>@candidateName</strong> as rejected for the position <strong>@jobTitle</strong>?
                                                            </p>
                                                        </div>
                                                        <div class="modal-footer border-0 pt-0">
                                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger fw-semibold">
                                                                <i class="bi bi-x-circle"></i> Yes, Reject
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-5 text-center">
            <div class="mx-auto mb-3" style="font-size:3rem; color: #f59e0b;">
                <i class="bi bi-star"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">No Shortlisted Applicants</h4>
            <p class="text-muted small mb-4" style="max-width: 500px; margin: 0 auto;">
                You do not currently have any shortlisted candidates@(selectedJobId.HasValue ? " for this job" : ""). Review your incoming applications and shortlist qualified candidates to see them here.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="JobApplications" asp-action="Index" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-file-earmark-person"></i> Review All Applications
                </a>
                <a asp-controller="Companies" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm px-4">
                    <i class="bi bi-speedometer2"></i> Back to Dashboard
                </a>
            </div>
        </div>
    }
</div>

